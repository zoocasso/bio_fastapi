# MySQL holding the reference tables (dbSNP, GWAS Catalog, 1000 Genomes, UniProt, MedlinePlus, ...)
BIO_DATABASE_URL=mysql+pymysql://bio:change-me@db.example.internal:3306/bio_db
# where uploaded genome files are kept
BIO_UPLOAD_DIR=input_data
# origins allowed to read the JSON API from a browser, comma-separated; none when unset
BIO_CORS_ORIGINS=http://reports.example.internal:3000
